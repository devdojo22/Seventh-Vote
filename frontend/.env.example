# Frontend build settings (Vite). Copy to frontend/.env and fill in. Values are baked into the public
# bundle at build time, so never put secrets here.

# Legal documents linked from the registration consent checkbox. Use the client-approved, absolute https
# URLs. Left empty or invalid, the names are shown without links (the consent checkbox still applies).
VITE_TERMS_OF_SERVICE_URL=
VITE_PRIVACY_POLICY_URL=
