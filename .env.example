# Copy to .env and fill in the blanks. Never commit .env.

# --- Postgres (avoid URL-special characters like @ : / in the password) ---
POSTGRES_USER=seventh
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=seventh_vote

# --- Tokens (shared by auth + api). Generate with: openssl rand -base64 48 ---
JWT_SECRET=
JWT_ISSUER=seventh-vote-auth
JWT_AUDIENCE=seventh-vote
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- MFA. Encrypts TOTP secrets at rest. Generate with: openssl rand -base64 32 ---
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Seventh Vote

# true behind HTTPS (staging/prod); false for http://localhost
COOKIE_SECURE=false
# Open sign-up is for local dev only; turn off once accounts are provisioned.
ALLOW_SELF_REGISTER=true

# --- Django (api service). Generate with: openssl rand -base64 48 ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,api

# --- LLM (api service). Leave the key blank to run with a stub answer. ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# --- Seed: first super-admin + pilot workspace (npm run seed in the auth container) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_WORKSPACE_NAME=Pilot City
SEED_WORKSPACE_SLUG=pilot-city
