
POSTGRES_USER=seventh
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=seventh_vote

JWT_SECRET=
JWT_ISSUER=seventh-vote-auth
JWT_AUDIENCE=seventh-vote
# API service only: where it checks each access token with the auth service (GET /auth/me). Optional;
# defaults to the Compose service address http://auth:4000.
# AUTH_SERVICE_URL=http://auth:4000
ACCESS_TOKEN_TTL=15m
# Sign-in sessions. Both are idle timeouts: each refresh of the 15-minute access token starts a new window,
# and the server enforces them whatever the browser does with the cookie.
#   "Keep me signed in" checked:   persistent cookie, signed out after REFRESH_TOKEN_TTL_DAYS without use.
#   "Keep me signed in" unchecked: browser-session cookie (normally dropped when the browser closes, though
#                                  browsers that restore sessions may keep it), and the server signs the
#                                  session out after BROWSER_SESSION_TTL_HOURS without use regardless.
REFRESH_TOKEN_TTL_DAYS=7
BROWSER_SESSION_TTL_HOURS=12

# Emailed one-time codes (MFA). OTP_HMAC_KEY: 32+ random characters.
OTP_HMAC_KEY=

# Email via Nylas Transactional Send. Backend only; never expose these to the frontend.
# NYLAS_API_URI is your Nylas application's region: https://api.us.nylas.com or https://api.eu.nylas.com.
# NYLAS_SEND_DOMAIN is a domain verified in the Nylas Dashboard, or your free <app>.nylas.email domain.
# EMAIL_FROM_ADDRESS must be an address on NYLAS_SEND_DOMAIN.
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_SEND_DOMAIN=your-app.nylas.email
EMAIL_FROM_ADDRESS=no-reply@your-app.nylas.email
EMAIL_FROM_NAME=Seventh Vote
# Optional: a monitored mailbox for replies, and an https link shown as "Privacy Statement" in emails.
EMAIL_REPLY_TO=
PRIVACY_STATEMENT_URL=

# Frontend origin used to build links in emails (password reset, invitations). Must be https in production.
APP_BASE_URL=http://localhost:8080
# Hours an emailed workspace invitation stays usable (1-336). Invitations are the only way to join a workspace.
INVITATION_TTL_HOURS=72

# Background cleanup inside the auth service: deletes expired refresh tokens, reset links, emailed codes,
# invitations and sign-in attempt windows. It never deletes accounts.
# Safe with several auth instances: a database lock lets only one of them clean at a time.
CLEANUP_INTERVAL_MINUTES=60

# false only for local http. NODE_ENV=production refuses to start unless it is true (site served over https).
COOKIE_SECURE=false

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,api

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# `npm run seed` (services/auth): the first super-admin (platform operator) and the pilot workspace.
# No Principal is seeded: the super-admin designates one via POST /auth/admin/workspaces/:id/principal.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_WORKSPACE_NAME=Memphis City Council
SEED_WORKSPACE_SLUG=memphis-city-council
